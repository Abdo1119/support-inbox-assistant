# Copy to .env and fill in.  .env is gitignored and is never committed.
#
# Every value below is intentionally left empty. Copying this file must not
# silently activate a setting -- an unset required variable stops the app at
# startup, which is the behaviour we want.

# ---------------------------------------------------------------------------
# Connection.  Required: app/config.py defines no defaults for these three, so
# no endpoint, model name, or credential is ever embedded in tracked source.
# ---------------------------------------------------------------------------

# Base URL of the OpenAI-compatible endpoint.
# e.g. http://localhost:11434/v1
LLM_BASE_URL=

# Model tag exactly as the endpoint reports it (`ollama list`).
# e.g. llama3.2:3b
LLM_MODEL=

# Ollama ignores this value entirely, but the openai SDK refuses to construct a
# client without one. Any non-empty string works locally. It becomes a real
# credential the moment LLM_BASE_URL points at a hosted provider, which is why
# it is required here rather than defaulted.
# e.g. ollama
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Operational knobs.  Each has a default in app/config.py, and that file is the
# single source of truth for the values -- they are deliberately not repeated
# here, so tuning one cannot leave a stale number behind in the other.
#
# These three are COMMENTED OUT on purpose. pydantic-settings treats an empty
# string as a value that is PRESENT, not absent, so a bare `LLM_MAX_TOKENS=`
# overrides the default with "" and fails to parse as an integer -- copying this
# template would break every command in the README. A commented line is genuine
# absence, so the default in app/config.py applies. Uncomment one only when you
# are giving it an actual value.
# ---------------------------------------------------------------------------

# Seconds before a single LLM call is abandoned.
# Must clear the cold-start cost: the first call after model load was measured
# at 17.3s, against 2.7-7.0s once the model was warm.
# LLM_TIMEOUT_SECONDS=

# Upper bound on generated tokens per call.
# Set too low, the response truncates mid-JSON -- that manufactures a parse
# failure on top of the ones the model already produces unprompted.
# LLM_MAX_TOKENS=

# Retries AFTER the first attempt, so N here means at most N+1 calls.
# The cap of 3 is derived from measurement, not picked: Phase 0 steady-state
# calls averaged 5.3s, so a full 30-ticket pass costs ~2.6 min at 1 attempt,
# ~5.3 min at 2, and ~7.9 min at 3. The prompt is expected to go through
# roughly ten eval runs while it is iterated on, which makes ~8 minutes the
# most any single run can afford to cost.
# LLM_MAX_RETRIES=

# ---------------------------------------------------------------------------
# Policy.
# ---------------------------------------------------------------------------

# Final confidence below which a ticket is escalated to a human reviewer.
# The comparison is strict: escalate when final_confidence < threshold.
# Required, with no default. Which tickets reach a person is a policy decision,
# not a technical one, so it must be chosen deliberately rather than inherited
# from a number nobody picked. This is a tuned value -- the justification for
# whatever it is set to lives in README.md, next to the numbers that produced it.
CONFIDENCE_THRESHOLD=
